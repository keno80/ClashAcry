<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ClashAcry.UI.Views.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AutomationProperties.AutomationId="OverviewPage">
  <!-- 状态一律由代码写进 *Label 的 Text，界面不读 pattern（R-12i/R-13c 同一条理由：UIA 的 Name 才是
       跨版本稳定的判据）。根 Grid 用 Transparent 底是为了让窗口材质透过来——Task 16 的像素取样拿
       PageBackground 这一块证明「亚克力真的铺满整窗」，卡片自己的底色挡不住它。 -->
  <Page.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Page.Resources>

  <Grid x:Name="Root" AutomationProperties.AutomationId="PageBackground" Background="Transparent">
    <ScrollViewer>
      <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="概览" Style="{ThemeResource TitleTextBlockStyle}" />

        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <TextBlock Text="内核" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="CoreStateLabel" AutomationProperties.AutomationId="CoreStateLabel"
                         FontWeight="SemiBold" MinWidth="64" />
            </StackPanel>
            <!-- 开关只是「发命令」，界面状态不由它翻转（spec §3 禁令 3）；文案交给右边那行标签。 -->
            <ToggleSwitch x:Name="CoreToggle" Header="启停内核" OffContent="停止" OnContent="运行"
                          AutomationProperties.AutomationId="CoreToggle" Toggled="OnCoreToggle" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <TextBlock Text="模式" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <!-- RadioButton 在 WinUI 3 + FlaUI 5 只认 SelectionItem（R-13c），Task 16 的外圈取样直接取
                 这三条自己的 rect，不再另挂 ModeRadioBorder（裁定 R-14b）。 -->
            <RadioButton x:Name="ModeRule" Content="规则（rule）" GroupName="ModeGroup"
                         AutomationProperties.AutomationId="ModeRule" Checked="OnModeChecked" />
            <RadioButton x:Name="ModeGlobal" Content="全局（global）" GroupName="ModeGroup"
                         AutomationProperties.AutomationId="ModeGlobal" Checked="OnModeChecked" />
            <RadioButton x:Name="ModeDirect" Content="直连（direct）" GroupName="ModeGroup"
                         AutomationProperties.AutomationId="ModeDirect" Checked="OnModeChecked" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <TextBlock Text="系统代理" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="SysProxyToggle" Header="开/关系统代理" OffContent="关闭" OnContent="开启"
                          AutomationProperties.AutomationId="SysProxyToggle" Toggled="OnSysProxyToggle" />
            <TextBlock x:Name="SysProxyStateLabel" AutomationProperties.AutomationId="SysProxyStateLabel"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <TextBlock Text="内核更新" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Button x:Name="UpdateButton" Content="更新内核" AutomationProperties.AutomationId="UpdateButton"
                    Click="OnUpdateClick" />
            <!-- 进度条只在「有进行中」时占位；不占位时这行高度为 0，静默刷新期间不会有任何跳动。 -->
            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="4"
                         AutomationProperties.AutomationId="UpdateProgress" Visibility="Collapsed" />
            <TextBlock x:Name="CoreVersionLabel" AutomationProperties.AutomationId="CoreVersionLabel"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <TextBlock Text="内核输出" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Button x:Name="LogButton" Content="展开内核输出" AutomationProperties.AutomationId="LogButton"
                    Click="OnLogButtonClick" />
            <!-- 日志是页内展开的面板，不是 Flyout（裁定 R-14b）：Flyout 活在独立 Popup 里，失焦即收，
                 UIA 取样和 Task 16 的像素取样都得先跟一阵「弹层还在不在」的轮询。 -->
            <Border x:Name="LogPanel" AutomationProperties.AutomationId="LogPanelBackground"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="8" Visibility="Collapsed">
              <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" AutomationProperties.AutomationId="LogText"
                           FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
